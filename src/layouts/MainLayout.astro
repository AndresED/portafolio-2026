---
import { Image } from 'astro:assets';
import { profile } from '../data/profile';
import profileAvatar from '../assets/profile-avatar.jpg';
import BaseLayout from './BaseLayout.astro';
import LanguageSwitcher from '../components/LanguageSwitcher.astro';

interface Props {
  currentPage?: 'home' | 'blog' | 'contact' | 'about' | 'resume' | 'certifications' | 'portfolio';
  title?: string;
  description?: string;
}

const { currentPage = 'home', title, description } = Astro.props;

type NavItem = {
  id: Props['currentPage'];
  label: string;
  href: string;
  icon: string;
  emphasis?: boolean;
};

const navItems: NavItem[] = [
  { id: 'about', label: 'About', href: '/#about', icon: 'user' },
  { id: 'resume', label: 'Resume', href: '/#resume', icon: 'briefcase' },
  { id: 'certifications', label: 'Certifications', href: '/#certifications', icon: 'badge' },
  { id: 'portfolio', label: 'Portfolio', href: '/portfolio', icon: 'folder', emphasis: true },
  { id: 'blog', label: 'Publications', href: '/blog', icon: 'edit' },
  { id: 'contact', label: 'Contact', href: '/contact', icon: 'mail', emphasis: true },
];

const iconPaths: Record<string, string> = {
  user: 'M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z',
  briefcase: 'M21 13.5A1.5 1.5 0 0019.5 12H21V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2h3.5M16 2v4M8 2v4M3 15h18M8 10h.01M16 14h.01',
  badge: 'M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 001.946-.806 3.42 3.42 0 014.438 0 3.42 3.42 0 001.946.806 3.42 3.42 0 013.138 3.138 3.42 3.42 0 00.806 1.946 3.42 3.42 0 010 4.438 3.42 3.42 0 00-.806 1.946 3.42 3.42 0 01-3.138 3.138 3.42 3.42 0 00-1.946.806 3.42 3.42 0 01-4.438 0 3.42 3.42 0 00-1.946-.806 3.42 3.42 0 01-3.138-3.138 3.42 3.42 0 00-.806-1.946 3.42 3.42 0 010-4.438 3.42 3.42 0 00.806-1.946 3.42 3.42 0 013.138-3.138z',
  folder: 'M3 7v10a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-6l-2-2H5a2 2 0 00-2 2z',
  edit: 'M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z',
  mail: 'M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z',
  github: 'M12 2C6.477 2 2 6.484 2 12.021c0 4.387 2.865 8.107 6.839 9.421.5.092.682-.217.682-.482 0-.237-.008-.866-.013-1.7-2.782.604-3.369-1.341-3.369-1.341-.454-1.155-1.11-1.462-1.11-1.462-.908-.62.069-.608.069-.608 1.003.07 1.531 1.03 1.531 1.03.892 1.529 2.341 1.087 2.91.831.092-.646.35-1.086.636-1.336-2.22-.253-4.555-1.11-4.555-4.943 0-1.091.39-1.984 1.029-2.683-.103-.253-.446-1.27.098-2.647 0 0 .84-.269 2.75 1.025A9.578 9.578 0 0112 6.836c.85.004 1.705.114 2.504.336 1.909-1.294 2.747-1.025 2.747-1.025.546 1.377.203 2.394.1 2.647.64.699 1.028 1.592 1.028 2.683 0 3.842-2.339 4.687-4.566 4.935.359.309.678.919.678 1.852 0 1.336-.012 2.415-.012 2.743 0 .267.18.578.688.48C19.138 20.125 22 16.404 22 12.021 22 6.484 17.522 2 12 2z',
  linkedin: 'M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z',
  twitter: 'M23 3a10.9 10.9 0 01-3.14 1.53 4.48 4.48 0 00-7.86 3v1A10.66 10.66 0 013 4s-4 9 5 13a11.64 11.64 0 01-7 2c9 5 20 0 20-11.5a4.5 4.5 0 00-.08-.83A7.72 7.72 0 0023 3z',
  medium: 'M2 3h3.972l.744 1.41a2.5 2.5 0 00.73 1.14L7 5.55V19h3V5.55l.544-.05c.34-.03.65-.21.86-.48l.72-.97V3H20v11h-3V3H2zM5 5.5h2v7H5v-7zm5.5 0h2v7h-2v-7zm4.5 0h2v7h-2v-7zM6 14.5l1.53.68 1.47.66V18H6v-3.5zm6 0l1.5.66 1.5.68V18h-3v-3.5z',
};

const socialIconPaths: Record<string, string> = {
  github: iconPaths.github,
  linkedin: iconPaths.linkedin,
  twitter: iconPaths.twitter,
  medium: iconPaths.medium,
};

function navClasses(item: NavItem, isActive: boolean) {
  return [
    'nav-item flex items-center gap-3 rounded-r-lg py-2.5 pr-3 text-sm transition-colors duration-200',
    item.emphasis ? 'nav-item-emphasis' : 'font-medium',
    isActive ? 'nav-item-active bg-white/[0.03]' : 'text-ink-muted hover:bg-white/[0.02] hover:text-ink',
  ];
}
---

<BaseLayout title={title} description={description}>
  <LanguageSwitcher />
  <button
    type="button"
    id="back-to-top"
    class="pointer-events-none invisible fixed bottom-6 right-4 z-[90] flex size-11 translate-y-2 items-center justify-center rounded-lg border border-white/10 bg-dark-800 text-ink-muted opacity-0 transition-[opacity,transform] duration-200 hover:border-accent-500/40 hover:text-accent-400 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent-500/40 lg:right-8"
    aria-label="Back to top"
    data-i18n-aria="layout.backToTop"
  >
    <svg class="size-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 10l7-7m0 0l7 7m-7-7v18" />
    </svg>
  </button>

  <div class="flex min-h-dvh">
    <!-- Sidebar -->
    <aside class="hidden border-r border-white/[0.06] bg-dark-800 lg:sticky lg:top-0 lg:flex lg:h-dvh lg:w-72 lg:shrink-0 lg:flex-col lg:p-6 xl:w-80">
      <div class="mb-6 flex shrink-0 flex-col">
        <div class="mb-4">
          <div class="mx-auto size-28 overflow-hidden rounded-xl border border-white/[0.08] bg-dark-700">
            <Image
              src={profileAvatar}
              alt={profile.name}
              width={112}
              height={112}
              densities={[1, 2]}
              class="size-full object-cover"
              loading="eager"
              decoding="async"
            />
          </div>
        </div>

        <div class="mb-3 text-center">
          <a href="/" class="group inline-block rounded focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent-500/40">
            <p class="text-lg font-bold text-ink transition-colors group-hover:text-accent-400">{profile.name}</p>
          </a>
          <p class="mt-1 font-mono text-xs text-meta-500">{profile.title}</p>
        </div>

        <p class="mb-5 text-center text-sm leading-relaxed text-ink-muted">
          <span data-i18n="profile.tagline">{profile.tagline}</span>
        </p>

        <div class="mb-5 flex justify-center gap-2">
          {
            profile.socials.map((social) => (
              <a
                href={social.url}
                target="_blank"
                rel="noopener noreferrer"
                class="flex size-9 items-center justify-center rounded-lg border border-white/[0.08] bg-dark-700 text-ink-muted transition-colors duration-200 hover:border-white/15 hover:text-ink focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent-500/40"
                aria-label={social.name}
              >
                <svg class="size-4" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path d={socialIconPaths[social.icon] || social.icon} />
                </svg>
              </a>
            ))
          }
        </div>

        <a
          href={profile.cvUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="btn-primary w-full"
        >
          <svg class="size-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
          </svg>
          <span data-i18n="layout.downloadCv">Download CV</span>
        </a>
      </div>

      <nav class="flex min-h-0 flex-1 flex-col gap-0.5 overflow-y-auto border-t border-white/[0.06] pt-4" aria-label="Main">
        {
          navItems.map((item) => (
            <a
              href={item.href}
              class={navClasses(item, currentPage === item.id)}
              data-section={item.id}
              data-nav-emphasis={item.emphasis ? 'true' : undefined}
            >
              <svg class="size-[18px] shrink-0 opacity-70" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={iconPaths[item.icon]} />
              </svg>
              <span data-i18n={`nav.${item.id}`}>{item.label}</span>
            </a>
          ))
        }
      </nav>

      <div class="mt-4 text-center font-mono text-[11px] text-ink-muted">
        <p>&copy; {new Date().getFullYear()}</p>
      </div>
    </aside>

    <!-- Mobile Header -->
    <header class="fixed inset-x-0 top-0 z-50 border-b border-white/[0.06] bg-dark-800/95 lg:hidden">
      <div class="flex items-center justify-between px-4 py-3">
        <a href="/" class="flex items-center gap-3 rounded focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent-500/40">
          <div class="size-10 shrink-0 overflow-hidden rounded-lg border border-white/[0.08] bg-dark-700">
            <Image
              src={profileAvatar}
              alt={profile.name}
              width={80}
              height={80}
              densities={[1, 2]}
              class="size-full object-cover"
              loading="eager"
              decoding="async"
            />
          </div>
          <div>
            <p class="text-sm font-semibold text-ink">{profile.name}</p>
            <p class="font-mono text-[11px] text-meta-500">{profile.title}</p>
          </div>
        </a>
        <button
          type="button"
          id="menu-toggle"
          class="rounded-lg p-2 transition-colors hover:bg-white/[0.04] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent-500/40"
          aria-label="Open navigation menu"
          aria-expanded="false"
          aria-controls="mobile-menu"
        >
          <svg class="size-6 text-ink-muted" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
        </button>
      </div>
    </header>

    <!-- Mobile Menu -->
    <div id="mobile-menu" class="fixed inset-0 z-40 hidden lg:hidden" role="dialog" aria-modal="true" aria-label="Site navigation">
      <div class="absolute inset-0 bg-dark-900/98"></div>
      <div class="relative flex h-full flex-col p-6">
        <button
          type="button"
          id="menu-close"
          class="mb-8 self-end rounded-lg p-2 transition-colors hover:bg-white/[0.04] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent-500/40"
          aria-label="Close navigation menu"
        >
          <svg class="size-6 text-ink-muted" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
        <nav class="space-y-1" aria-label="Main">
          {
            navItems.map((item) => (
              <a
                href={item.href}
                class:list={[
                  'mobile-nav-item block rounded-lg border-l-2 py-3.5 pl-4 pr-3 text-base transition-colors duration-200',
                  item.emphasis ? 'font-semibold' : 'font-medium',
                  currentPage === item.id
                    ? 'border-accent-500 bg-white/[0.03] text-accent-400'
                    : 'border-transparent text-ink-muted hover:bg-white/[0.02] hover:text-ink',
                ]}
                data-section={item.id}
              >
                <span data-i18n={`nav.${item.id}`}>{item.label}</span>
              </a>
            ))
          }
        </nav>
        <div class="mt-auto pt-8">
          <a href={profile.cvUrl} target="_blank" rel="noopener noreferrer" class="btn-primary flex w-full">
            <svg class="size-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
            </svg>
            <span data-i18n="layout.downloadCv">Download CV</span>
          </a>
        </div>
      </div>
    </div>

    <!-- Main -->
    <main class="min-w-0 flex-1 pt-[4.25rem] lg:pt-0">
      <div class="mx-auto max-w-3xl px-4 py-8 sm:px-6 lg:px-10 lg:py-12 xl:max-w-4xl">
        <slot />
      </div>
    </main>
  </div>

  <script define:vars={{ currentPage }}>
    const menuToggle = document.getElementById('menu-toggle');
    const menuClose = document.getElementById('menu-close');
    const mobileMenu = document.getElementById('mobile-menu');

    menuToggle?.addEventListener('click', () => {
      mobileMenu?.classList.remove('hidden');
      document.body.style.overflow = 'hidden';
      menuToggle?.setAttribute('aria-expanded', 'true');
    });

    menuClose?.addEventListener('click', () => {
      mobileMenu?.classList.add('hidden');
      document.body.style.overflow = '';
      menuToggle?.setAttribute('aria-expanded', 'false');
    });

    document.querySelectorAll('.mobile-nav-item').forEach((item) => {
      item.addEventListener('click', () => {
        mobileMenu?.classList.add('hidden');
        document.body.style.overflow = '';
        menuToggle?.setAttribute('aria-expanded', 'false');
      });
    });

    const backToTop = document.getElementById('back-to-top');
    const scrollThreshold = 320;

    function syncBackToTopVisibility() {
      if (!backToTop) return;
      const show = window.scrollY > scrollThreshold;
      backToTop.classList.toggle('opacity-0', !show);
      backToTop.classList.toggle('translate-y-2', !show);
      backToTop.classList.toggle('pointer-events-none', !show);
      backToTop.classList.toggle('invisible', !show);
    }

    window.addEventListener('scroll', syncBackToTopVisibility, { passive: true });
    syncBackToTopVisibility();

    backToTop?.addEventListener('click', () => {
      window.scrollTo({ top: 0, behavior: 'smooth' });
    });

    if (currentPage === 'home') {
      const navOffset = () => (window.innerWidth >= 1024 ? 120 : 160);

      function updateActiveNav() {
        const scrollPos = window.scrollY + navOffset();
        const sections = Array.from(document.querySelectorAll('main section[id]')).filter(
          (section) => section.id !== 'hero',
        );
        let activeId = sections[0]?.id ?? '';

        for (const section of sections) {
          if (section.offsetTop <= scrollPos) {
            activeId = section.id;
          }
        }

        const lastSection = sections[sections.length - 1];
        if (
          lastSection &&
          window.innerHeight + window.scrollY >= document.documentElement.scrollHeight - 48
        ) {
          activeId = lastSection.id;
        }

        document.querySelectorAll('.nav-item, .mobile-nav-item').forEach((item) => {
          const sectionId = item.getAttribute('data-section');
          const isHashNav = (item.getAttribute('href') ?? '').includes('#');
          const isEmphasis = item.getAttribute('data-nav-emphasis') === 'true';

          item.classList.remove(
            'nav-item-active',
            'border-accent-500',
            'bg-white/[0.03]',
            'text-accent-400',
            'text-ink-muted',
            'border-transparent',
          );

          if (isHashNav && sectionId === activeId) {
            item.classList.add('nav-item-active', 'border-accent-500', 'bg-white/[0.03]', 'text-accent-400');
            if (item.classList.contains('mobile-nav-item')) {
              item.classList.add('border-accent-500', 'bg-white/[0.03]', 'text-accent-400');
            }
          } else if (item.classList.contains('nav-item')) {
            item.classList.add('text-ink-muted');
          } else {
            item.classList.add('border-transparent', 'text-ink-muted');
            if (isEmphasis) item.classList.add('font-semibold');
          }
        });
      }

      window.addEventListener('scroll', updateActiveNav, { passive: true });
      window.addEventListener('hashchange', updateActiveNav);
      window.addEventListener('resize', updateActiveNav, { passive: true });
      updateActiveNav();
      requestAnimationFrame(updateActiveNav);
    }
  </script>
</BaseLayout>
