---
import { profile } from '../../data/profile';
---

<section id="contact" class="mb-16 lg:mb-24">
  <h2 class="section-title mb-8 reveal" data-i18n="contact.title">Get In Touch</h2>

  <div class="grid grid-cols-1 gap-8 lg:grid-cols-2">
    <!-- Contact Info -->
    <div class="reveal space-y-6">
      <div class="glass-card p-6">
        <h3 class="mb-4 text-lg font-semibold text-white" data-i18n="contact.connectTitle">Let's Connect</h3>
        <p class="mb-6 text-sm leading-relaxed text-gray-400" data-i18n="contact.connectLead">
          I'm always open to discussing new opportunities, interesting projects, or just having a friendly conversation about technology. Feel free to reach out!
        </p>

        <div class="mb-6 space-y-4">
          <a
            href={`mailto:${profile.email}`}
            class="group flex items-center gap-4 rounded-xl bg-dark-700/50 p-4 transition-colors hover:bg-dark-600"
            aria-label={`Send email to ${profile.email}`}
          >
            <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-accent-500/10 transition-colors group-hover:bg-accent-500/20">
              <svg class="h-6 w-6 text-accent-400" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
              </svg>
            </div>
            <div>
              <p class="text-sm text-gray-400" data-i18n="contact.email">Email</p>
              <p class="font-medium text-white">{profile.email}</p>
            </div>
          </a>

          <div class="flex items-center gap-4 rounded-xl bg-dark-700/50 p-4">
            <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-accent-500/10">
              <svg class="h-6 w-6 text-accent-400" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
              </svg>
            </div>
            <div>
              <p class="text-sm text-gray-400" data-i18n="contact.location">Location</p>
              <p class="font-medium text-white">{profile.location}</p>
            </div>
          </div>
        </div>

        <!-- Social Links -->
        <div class="flex items-center gap-3">
          {profile.socials.map((social) => (
            <a 
              href={social.url} 
              target="_blank" 
              rel="noopener noreferrer"
              class="w-12 h-12 rounded-xl bg-dark-700 hover:bg-dark-600 flex items-center justify-center text-gray-400 hover:text-white transition-all hover:-translate-y-1"
              aria-label={social.name}
            >
              <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path d={
                  social.icon === 'github' ? 'M12 2C6.477 2 2 6.484 2 12.021c0 4.387 2.865 8.107 6.839 9.421.5.092.682-.217.682-.482 0-.237-.008-.866-.013-1.7-2.782.604-3.369-1.341-3.369-1.341-.454-1.155-1.11-1.462-1.11-1.462-.908-.62.069-.608.069-.608 1.003.07 1.531 1.03 1.531 1.03.892 1.529 2.341 1.087 2.91.831.092-.646.35-1.086.636-1.336-2.22-.253-4.555-1.11-4.555-4.943 0-1.091.39-1.984 1.029-2.683-.103-.253-.446-1.27.098-2.647 0 0 .84-.269 2.75 1.025A9.578 9.578 0 0112 6.836c.85.004 1.705.114 2.504.336 1.909-1.294 2.747-1.025 2.747-1.025.546 1.377.203 2.394.1 2.647.64.699 1.028 1.592 1.028 2.683 0 3.842-2.339 4.687-4.566 4.935.359.309.678.919.678 1.852 0 1.336-.012 2.415-.012 2.743 0 .267.18.578.688.48C19.138 20.125 22 16.404 22 12.021 22 6.484 17.522 2 12 2z' :
                  social.icon === 'linkedin' ? 'M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z' :
                  social.icon === 'twitter' ? 'M23 3a10.9 10.9 0 01-3.14 1.53 4.48 4.48 0 00-7.86 3v1A10.66 10.66 0 013 4s-4 9 5 13a11.64 11.64 0 01-7 2c9 5 20 0 20-11.5a4.5 4.5 0 00-.08-.83A7.72 7.72 0 0023 3z' :
                  social.icon === 'medium' ? 'M2 3h3.972l.744 1.41a2.5 2.5 0 00.73 1.14L7 5.55V19h3V5.55l.544-.05c.34-.03.65-.21.86-.48l.72-.97V3H20v11h-3V3H2zM5 5.5h2v7H5v-7zm5.5 0h2v7h-2v-7zm4.5 0h2v7h-2v-7zM6 14.5l1.53.68 1.47.66V18H6v-3.5zm6 0l1.5.66 1.5.68V18h-3v-3.5z' : ''
                } />
              </svg>
            </a>
          ))}
        </div>
      </div>
    </div>

    <!-- Contact Form -->
    <div class="reveal" style="animation-delay: 100ms">
      <form id="contact-form" class="glass-card p-6 space-y-6">
        <!-- Honeypot -->
        <input type="text" name="honeypot" class="hidden" tabindex="-1" autocomplete="off" />

        <div class="grid grid-cols-1 gap-6 md:grid-cols-2">
          <div>
            <label for="name" class="mb-2 block text-sm font-medium text-gray-300" data-i18n="contact.form.name">Name</label>
            <input
              type="text"
              id="name"
              name="name"
              required
              data-i18n-placeholder="contact.placeholder.name"
              placeholder="Your name"
              class="w-full rounded-xl border border-white/5 bg-dark-700 px-4 py-3 text-white transition-all placeholder-gray-500 focus:border-accent-500/50 focus:outline-none focus:ring-1 focus:ring-accent-500/20"
            />
          </div>
          <div>
            <label for="email" class="mb-2 block text-sm font-medium text-gray-300" data-i18n="contact.form.email">Email</label>
            <input
              type="email"
              id="email"
              name="email"
              required
              data-i18n-placeholder="contact.placeholder.email"
              placeholder="your@email.com"
              class="w-full rounded-xl border border-white/5 bg-dark-700 px-4 py-3 text-white transition-all placeholder-gray-500 focus:border-accent-500/50 focus:outline-none focus:ring-1 focus:ring-accent-500/20"
            />
          </div>
        </div>

        <div>
          <label for="subject" class="mb-2 block text-sm font-medium text-gray-300" data-i18n="contact.form.subject">Subject</label>
          <input
            type="text"
            id="subject"
            name="subject"
            required
            data-i18n-placeholder="contact.placeholder.subject"
            placeholder="What's this about?"
            class="w-full rounded-xl border border-white/5 bg-dark-700 px-4 py-3 text-white transition-all placeholder-gray-500 focus:border-accent-500/50 focus:outline-none focus:ring-1 focus:ring-accent-500/20"
          />
        </div>

        <div>
          <label for="message" class="mb-2 block text-sm font-medium text-gray-300" data-i18n="contact.form.message">Message</label>
          <textarea
            id="message"
            name="message"
            rows="5"
            required
            data-i18n-placeholder="contact.placeholder.message"
            placeholder="Tell me about your project or opportunity..."
            class="w-full resize-none rounded-xl border border-white/5 bg-dark-700 px-4 py-3 text-white transition-all placeholder-gray-500 focus:border-accent-500/50 focus:outline-none focus:ring-1 focus:ring-accent-500/20"
          ></textarea>
        </div>

        <button
          type="submit"
          id="submit-btn"
          class="btn-primary flex w-full cursor-pointer items-center justify-center gap-2 disabled:cursor-not-allowed disabled:opacity-50"
        >
          <span id="btn-text" data-i18n="contact.btn.send">Send Message</span>
          <svg id="btn-icon" class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8" />
          </svg>
          <svg id="btn-spinner" class="w-5 h-5 animate-spin hidden" fill="none" viewBox="0 0 24 24">
            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
            <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
          </svg>
        </button>

        <!-- Status Messages -->
        <div id="success-message" class="hidden p-4 rounded-xl bg-green-500/10 border border-green-500/20 text-green-400 text-sm">
          <div class="flex items-center gap-2">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
            </svg>
            <span data-i18n="contact.success">Message sent successfully! I'll get back to you soon.</span>
          </div>
        </div>

        <div id="error-message" class="hidden p-4 rounded-xl bg-red-500/10 border border-red-500/20 text-red-400 text-sm">
          <div class="flex items-center gap-2">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            <span data-i18n="contact.error">Something went wrong. Please try again or email me directly.</span>
          </div>
        </div>
      </form>

      <p class="mt-4 text-center text-xs text-gray-400" data-i18n="contact.privacyNote">
        Your information is secure and will never be shared.
      </p>
    </div>
  </div>
</section>

<script>
  type PortfolioI18n = { t: (key: string) => string };

  function getI18n(): PortfolioI18n | undefined {
    return (window as unknown as { portfolioI18n?: PortfolioI18n }).portfolioI18n;
  }

  function labelSend(): string {
    return getI18n()?.t('contact.btn.send') ?? 'Send Message';
  }

  function labelSending(): string {
    return getI18n()?.t('contact.btn.sending') ?? 'Sending...';
  }

  // EmailJS Integration
  // TODO: Replace with your EmailJS credentials
  // Add to your .env file:
  // PUBLIC_EMAILJS_SERVICE_ID=your_service_id
  // PUBLIC_EMAILJS_TEMPLATE_ID=your_template_id
  // PUBLIC_EMAILJS_PUBLIC_KEY=your_public_key

  const form = document.getElementById('contact-form') as HTMLFormElement;
  const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement;
  const btnText = document.getElementById('btn-text');
  const btnIcon = document.getElementById('btn-icon');
  const btnSpinner = document.getElementById('btn-spinner');
  const successMessage = document.getElementById('success-message');
  const errorMessage = document.getElementById('error-message');

  window.addEventListener('portfolio-locale-changed', () => {
    if (!submitBtn?.disabled && btnText) btnText.textContent = labelSend();
  });

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();

    // Honeypot check
    const honeypot = form.querySelector('input[name="honeypot"]') as HTMLInputElement;
    if (honeypot?.value) return;

    // Show loading state
    if (btnText) btnText.textContent = labelSending();
    if (btnIcon) btnIcon.classList.add('hidden');
    if (btnSpinner) btnSpinner.classList.remove('hidden');
    submitBtn.disabled = true;

    try {
      // Check if EmailJS is configured
      const serviceId = (import.meta as any).env?.PUBLIC_EMAILJS_SERVICE_ID;
      const templateId = (import.meta as any).env?.PUBLIC_EMAILJS_TEMPLATE_ID;
      const publicKey = (import.meta as any).env?.PUBLIC_EMAILJS_PUBLIC_KEY;

      if (serviceId && templateId && publicKey) {
        // Load EmailJS if not already loaded
        if (!(window as any).emailjs) {
          await loadScript('https://cdn.jsdelivr.net/npm/@emailjs/browser@4/dist/email.min.js');
        }

        await (window as any).emailjs.send(
          serviceId,
          templateId,
          {
            from_name: (form.querySelector('#name') as HTMLInputElement).value,
            from_email: (form.querySelector('#email') as HTMLInputElement).value,
            subject: (form.querySelector('#subject') as HTMLInputElement).value,
            message: (form.querySelector('#message') as HTMLTextAreaElement).value,
          },
          publicKey
        );
      } else {
        // Demo mode - simulate sending
        await new Promise((resolve) => setTimeout(resolve, 1500));
      }

      // Success
      if (successMessage) successMessage.classList.remove('hidden');
      if (errorMessage) errorMessage.classList.add('hidden');
      form.reset();
    } catch (error) {
      console.error('Email error:', error);
      if (errorMessage) errorMessage.classList.remove('hidden');
      if (successMessage) successMessage.classList.add('hidden');
    } finally {
      if (btnText) btnText.textContent = labelSend();
      if (btnIcon) btnIcon.classList.remove('hidden');
      if (btnSpinner) btnSpinner.classList.add('hidden');
      submitBtn.disabled = false;
    }
  });

  function loadScript(src: string): Promise<void> {
    return new Promise((resolve, reject) => {
      const script = document.createElement('script');
      script.src = src;
      script.onload = () => resolve();
      script.onerror = reject;
      document.head.appendChild(script);
    });
  }
</script>