---
import type { Experience, Education } from '../../types';
import { experiences, education, certifications, skillCategories } from '../../data/resume';
import LocalePair from '../LocalePair.astro';
import { experienceSectionLayout } from '../../config/resume-ui';
import ResumeExperienceTimeline from './ResumeExperienceTimeline.astro';
import ResumeExperienceRail from './ResumeExperienceRail.astro';
import ResumeExperienceBriefcase from './ResumeExperienceBriefcase.astro';

type TimelineItem =
  | { kind: 'experience'; data: Experience }
  | { kind: 'education'; data: Education };

const timelineItems: TimelineItem[] = [
  ...experiences.map((data) => ({ kind: 'experience' as const, data })),
  ...education.map((data) => ({ kind: 'education' as const, data })),
];

const firstEducationIndex = experiences.length;
---

<section id="resume" class="mb-16 lg:mb-24">
  <h2
    class:list={[
      'mb-8 reveal',
      experienceSectionLayout === 'briefcase' ? 'sr-only' : 'section-title',
    ]}
    data-i18n="resume.sectionTitle"
  >
    Experience & Education
  </h2>

  {
    experienceSectionLayout === 'briefcase' ? (
      <ResumeExperienceBriefcase experiences={experiences} education={education} />
    ) : experienceSectionLayout === 'rail' ? (
      <ResumeExperienceRail timelineItems={timelineItems} firstEducationIndex={firstEducationIndex} />
    ) : (
      <ResumeExperienceTimeline timelineItems={timelineItems} firstEducationIndex={firstEducationIndex} />
    )
  }

  <!-- Certifications -->
  <div class="mb-12 reveal">
    <h3 class="mb-6 text-xl font-semibold text-white" data-i18n="resume.certifications">Certifications</h3>
    <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
      {certifications.map((cert: any) => (
        <a
          href={cert.url || '#'}
          target="_blank"
          rel="noopener noreferrer"
          class="glass-card group p-4 transition-all duration-300 hover:border-accent-500/30"
          aria-label={`${cert.name.en} — ${cert.issuer.en} (opens certification details)`}
        >
          <div class="flex items-start gap-3">
            <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-orange-500/10 transition-colors group-hover:bg-orange-500/20">
              <svg class="h-5 w-5 text-orange-400" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M12 2L9.19 8.63 2 9.24l5.46 4.73L5.82 21 12 17.27 18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2z" />
              </svg>
            </div>
            <div class="min-w-0 flex-1">
              <h4 class="truncate text-sm font-semibold text-white transition-colors group-hover:text-accent-400">
                <LocalePair text={cert.name} />
              </h4>
              <p class="text-xs text-gray-400">
                <LocalePair text={cert.issuer} />
              </p>
              <p class="mt-1 text-xs text-gray-500">
                <LocalePair text={cert.date} />
              </p>
            </div>
            <svg
              class="h-4 w-4 shrink-0 text-gray-500 transition-colors group-hover:text-accent-400"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
              aria-hidden="true"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"
              />
            </svg>
          </div>
        </a>
      ))}
    </div>
  </div>

  <!-- Skills -->
  <div class="reveal">
    <h3 class="mb-6 text-xl font-semibold text-white" data-i18n="resume.skillsTitle">Technical Proficiency</h3>
    <div class="grid grid-cols-1 gap-6 md:grid-cols-2">
      {Object.entries(skillCategories).map(([skillKey, category]: [string, any]) => (
        <div class="glass-card p-6">
          <h4
            class="mb-4 text-sm font-semibold uppercase tracking-wider text-gray-400"
            data-i18n={`skills.label.${skillKey}`}
          >
            {category.label}
          </h4>
          <div class="flex flex-wrap gap-2">
            {category.skills.map((skill: string) => (
              <span
                class:list={[
                  'cursor-default rounded-lg border border-white/5 bg-dark-600 px-3 py-1.5 text-sm text-gray-300 transition-all hover:border-accent-500/30 hover:text-accent-400',
                  skill === 'AWS' ? 'border-orange-500/20 text-orange-400' : '',
                ]}
              >
                {skill}
              </span>
            ))}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
