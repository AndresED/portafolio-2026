---
import type { Experience, Education } from '../../types';
import { experiences, education } from '../../data/resume';
import LocalePair from '../LocalePair.astro';
import { experienceSectionLayout } from '../../config/resume-ui';
import ResumeExperienceTimeline from './ResumeExperienceTimeline.astro';
import ResumeExperienceRail from './ResumeExperienceRail.astro';
import ResumeExperienceBriefcase from './ResumeExperienceBriefcase.astro';

type TimelineItem =
  | { kind: 'experience'; data: Experience }
  | { kind: 'education'; data: Education };

const timelineItems: TimelineItem[] = [
  ...experiences.map((data) => ({ kind: 'experience' as const, data })),
  ...education.map((data) => ({ kind: 'education' as const, data })),
];

const firstEducationIndex = experiences.length;
---

<section id="resume" class="mb-16 lg:mb-24">
  <h2
    class:list={[
      'mb-8 reveal',
      experienceSectionLayout === 'briefcase' ? 'sr-only' : 'section-title',
    ]}
    data-i18n="resume.sectionTitle"
  >
    Experience & Education
  </h2>

  {
    experienceSectionLayout === 'briefcase' ? (
      <ResumeExperienceBriefcase experiences={experiences} education={education} />
    ) : experienceSectionLayout === 'rail' ? (
      <ResumeExperienceRail timelineItems={timelineItems} firstEducationIndex={firstEducationIndex} />
    ) : (
      <ResumeExperienceTimeline timelineItems={timelineItems} firstEducationIndex={firstEducationIndex} />
    )
  }
</section>
