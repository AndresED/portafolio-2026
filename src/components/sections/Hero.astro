---
import { profile } from '../../data/profile';

const linkedIn = profile.socials.find((s) => s.icon === 'linkedin');
---

<section id="hero" class="reveal mb-16 border-b border-white/[0.06] pb-14 lg:mb-20 lg:pb-16" aria-labelledby="hero-heading">
  <p class="section-label mb-4" data-i18n="hero.eyebrow">
    Senior Backend Engineer · Perú
  </p>

  <h1 id="hero-heading" class="font-display text-balance text-4xl font-bold tracking-tight text-ink md:text-5xl lg:text-[3.25rem] lg:leading-tight">
    {profile.name}
  </h1>

  <p class="mt-5 max-w-2xl text-pretty text-lg leading-7 text-ink-body md:text-xl" data-i18n="hero.thesis">
    Senior backend engineer (5+ years) shipping NestJS microservices on AWS for logistics and compliance products — event-driven, multitenant, production-first.
  </p>

  <p class="mt-4 font-mono text-sm text-meta-500" data-i18n="hero.fit">
    Remote · Peru (UTC-5) · Backend & platform roles · English & Spanish
  </p>

  {
    profile.status.available && (
      <p class="mt-4 inline-flex items-center rounded-md border border-emerald-500/30 bg-emerald-500/10 px-3 py-1.5 font-mono text-xs text-emerald-400">
        <span data-i18n="profile.openToWork">{profile.status.text}</span>
      </p>
    )
  }

  <p class="mt-5 font-mono text-sm tabular-nums text-meta-500" data-i18n="hero.evidence">
    NESTJS · AWS · HEXAGONAL · KAFKA · POSTGRESQL
  </p>

  <div class="mt-8 flex flex-wrap items-center gap-3">
    <a href="/portfolio" class="btn-primary" data-i18n="hero.ctaPortfolio">
      View portfolio
    </a>
    <a href="/contact" class="btn-secondary" data-i18n="hero.ctaContact">
      Get in touch
    </a>
    {
      linkedIn && (
        <a
          href={linkedIn.url}
          target="_blank"
          rel="noopener noreferrer"
          class="btn-secondary"
          data-i18n="hero.ctaLinkedin"
        >
          LinkedIn ↗
        </a>
      )
    }
    <a
      href={profile.cvUrl}
      target="_blank"
      rel="noopener noreferrer"
      class="btn-ghost"
      data-i18n="hero.ctaCv"
    >
      CV ↗
    </a>
  </div>
</section>
