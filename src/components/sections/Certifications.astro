---
import { visibleCertifications, certificationsAreUpcomingOnly } from '../../data/resume';
import LocalePair from '../LocalePair.astro';

const statusStyles = {
  valid: 'border-emerald-500/25 bg-emerald-500/10 text-emerald-400',
  in_progress: 'border-amber-500/25 bg-amber-500/10 text-amber-400',
} as const;

const certifications = visibleCertifications;
---

{
  certifications.length > 0 && (
    <section id="certifications" class="mb-16 lg:mb-24">
      <div class="mb-10 reveal">
        <p class="section-label mb-3" data-i18n="certs.badge">Credentials</p>
        <h2
          class="section-title !mb-0"
          data-i18n={certificationsAreUpcomingOnly ? 'certs.upcomingTitle' : 'certs.title'}
        >
          {certificationsAreUpcomingOnly ? 'Upcoming credentials' : 'Certifications'}
        </h2>
      </div>

      <div class="grid grid-cols-1 gap-5 sm:grid-cols-2">
        {
          certifications.map((cert, index) => (
            <article
              class="glass-card group reveal flex flex-col p-5 transition-colors duration-200 hover:border-accent-500/25"
              style={`animation-delay: ${index * 80}ms`}
            >
              <div class="mb-5 flex items-start justify-between gap-3">
                <div
                  class:list={[
                    'flex h-11 w-11 shrink-0 items-center justify-center rounded-xl border text-xs font-bold uppercase tracking-wide',
                    cert.icon === 'aws'
                      ? 'border-orange-500/30 bg-orange-500/10 text-orange-400'
                      : 'border-white/10 bg-surface-raised text-ink-muted',
                  ]}
                >
                  {cert.icon === 'aws' ? 'aws' : cert.issuerShort.slice(0, 3)}
                </div>
                <span
                  class:list={[
                    'inline-flex items-center gap-1.5 rounded-full border px-2.5 py-1 text-[10px] font-semibold uppercase tracking-wider',
                    statusStyles[cert.status],
                  ]}
                >
                  {cert.status === 'valid' ? (
                    <>
                      <svg class="h-3 w-3" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
                      </svg>
                      <span data-i18n="certs.status.valid">Valid</span>
                    </>
                  ) : (
                    <span data-i18n="certs.status.inProgress">In progress</span>
                  )}
                </span>
              </div>

              <h3 class="mb-2 text-base font-bold leading-snug text-ink transition-colors group-hover:text-accent-400">
                <LocalePair text={cert.name} />
              </h3>
              <p class="mb-5 font-mono text-xs uppercase tracking-normal text-meta-500">
                {cert.code} · {cert.issuerShort}
              </p>

              <dl class="mb-5 space-y-2 text-base">
                <div class="flex items-baseline justify-between gap-3">
                  <dt class="text-meta-500" data-i18n="certs.issued">Issued</dt>
                  <dd class="text-right font-medium text-ink-muted">
                    <LocalePair text={cert.issuedAt} />
                  </dd>
                </div>
                <div class="flex items-baseline justify-between gap-3">
                  <dt class="text-meta-500" data-i18n="certs.expires">Expires</dt>
                  <dd class="text-right font-medium text-ink-muted">
                    {cert.expiresNever ? (
                      <span data-i18n="certs.noExpiry">Does not expire</span>
                    ) : cert.expiresAt ? (
                      <LocalePair text={cert.expiresAt} />
                    ) : (
                      '—'
                    )}
                  </dd>
                </div>
              </dl>

              {
                cert.verifyUrl && (
                  <a
                    href={cert.verifyUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="mt-auto inline-flex items-center gap-1.5 text-sm font-medium text-accent-400 transition-colors hover:text-accent-300"
                  >
                    <span data-i18n="certs.verify">Verify</span>
                    <svg class="h-3.5 w-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"
                      />
                    </svg>
                  </a>
                )
              }
            </article>
          ))
        }
      </div>
    </section>
  )
}
