---
import { Image } from 'astro:assets';
import { posts, blogBatchSize, blogAboveFoldEagerCount, blogFilters } from '../../data/blog';
import { blogPath } from '../../data/seo';

const imageModules = import.meta.glob<{ default: ImageMetadata }>(
  '../../assets/blog/*.{png,jpg,jpeg,svg,webp}',
  { eager: true },
);

const blogImages: Record<string, ImageMetadata> = {};
for (const [path, mod] of Object.entries(imageModules)) {
  const filename = path.split('/').pop()!;
  blogImages[filename] = mod.default;
}

const allPosts = posts;
const hasMorePosts = allPosts.length > blogBatchSize;

function formatPostDate(iso: string): string {
  return new Date(iso).toLocaleDateString('en-GB', { day: 'numeric', month: 'short' });
}
---

<section id="blog" class="mb-16 lg:mb-24">
  <div class="reveal mb-12 text-center">
    <h1 class="section-title mb-4" data-i18n="blog.title">Publications</h1>
    <p class="mx-auto max-w-2xl text-base leading-7 text-ink-muted md:text-lg" data-i18n="blog.lead">
      Technical articles on algorithms, data structures, cryptography, and software design from Making Code, my technical blog.
    </p>
  </div>

  <div
    class="reveal mb-10 flex flex-wrap items-center justify-center gap-x-6 gap-y-2 border-b border-white/[0.06] pb-4"
    role="tablist"
    aria-label="Publication categories"
  >
    {
      blogFilters.map((filter) => (
        <button
          type="button"
          class:list={[
            'blog-filter filter-tab',
            filter.id === 'all' ? 'filter-tab-active' : 'filter-tab-inactive',
          ]}
          data-filter={filter.id}
          role="tab"
          aria-selected={filter.id === 'all' ? 'true' : 'false'}
          data-i18n={filter.i18nKey}
        >
          {filter.label}
        </button>
      ))
    }
  </div>

  <div id="blog-grid" class="media-card-list">
    {
      allPosts.map((post, index) => {
        const filename = post.coverImage.split('/').pop()!;
        const localImg = blogImages[filename];
        const isScrollHidden = index >= blogBatchSize;
        const isInitialVisible = !isScrollHidden;
        const isAboveFold = isInitialVisible && index < blogAboveFoldEagerCount;
        const isLcp = index === 0 && isInitialVisible;

        return (
          <a
            href={blogPath(post.id)}
            class:list={[
              'blog-post group glass-card media-card transition-colors duration-200 hover:border-accent-500/25 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent-500/30 reveal',
              isScrollHidden && 'blog-post--scroll-hidden',
            ]}
            data-index={index}
            data-category={post.category}
            style={`animation-delay: ${Math.min(index, blogBatchSize - 1) * 100}ms`}
            aria-label={post.title}
          >
            <div class="media-card__media">
              {
                localImg && (
                  <Image
                    src={localImg}
                    alt={post.title}
                    width={640}
                    height={360}
                    class="size-full object-cover opacity-90 transition-opacity duration-200 group-hover:opacity-100"
                    loading={isAboveFold ? 'eager' : 'lazy'}
                    decoding="async"
                    fetchpriority={isLcp ? 'high' : isAboveFold ? 'low' : undefined}
                  />
                )
              }
            </div>
            <div class="media-card__body">
              <h3 class="media-card__title">{post.title}</h3>
              <p class="media-card__excerpt">{post.description}</p>
              <div class="media-card__tags">
                {post.tags.map((tag) => (
                  <span class="tag">{tag}</span>
                ))}
              </div>
              <div class="media-card__footer">
                <time datetime={post.publishedAt}>{formatPostDate(post.publishedAt)}</time>
                <span class="inline-flex items-center gap-1.5">
                  {post.readingTime}
                  <span aria-hidden="true">→</span>
                </span>
              </div>
            </div>
          </a>
        );
      })
    }
  </div>

  <p id="blog-empty" class="hidden py-16 text-center text-ink-muted" data-i18n="blog.empty">
    No articles in this category yet.
  </p>

  {
    hasMorePosts && (
      <div id="blog-sentinel" class="mt-8 flex justify-center py-4" aria-hidden="true">
        <span class="text-base text-ink-muted" data-i18n="blog.loading">Loading more articles…</span>
      </div>
    )
  }
</section>

<style>
  .blog-post--scroll-hidden,
  .blog-post--filter-hidden {
    display: none;
  }
</style>

<script define:vars={{ blogBatchSize }}>
  const grid = document.getElementById('blog-grid');
  const sentinel = document.getElementById('blog-sentinel');
  const emptyState = document.getElementById('blog-empty');
  const filterButtons = document.querySelectorAll('.blog-filter');
  const allCards = grid ? [...grid.querySelectorAll('.blog-post')] : [];

  let currentFilter = 'all';
  let scrollObserver = null;

  function matchesFilter(card) {
    const category = card.getAttribute('data-category');
    return currentFilter === 'all' || category === currentFilter;
  }

  function setActiveFilter(active) {
    filterButtons.forEach((button) => {
      const isActive = button === active;
      button.setAttribute('aria-selected', isActive ? 'true' : 'false');
      button.classList.toggle('filter-tab-active', isActive);
      button.classList.toggle('filter-tab-inactive', !isActive);
      button.classList.toggle('border-accent-400', isActive);
      button.classList.toggle('text-accent-400', isActive);
      button.classList.toggle('border-transparent', !isActive);
    });
  }

  function updateSentinel(matchingCards) {
    if (!sentinel) return;

    const pending = matchingCards.filter((card) =>
      card.classList.contains('blog-post--scroll-hidden'),
    );

    sentinel.classList.toggle('hidden', pending.length === 0);
  }

  function applyFilter(filter) {
    currentFilter = filter;

    const matchingCards = allCards.filter(matchesFilter);

    allCards.forEach((card) => {
      card.classList.toggle('blog-post--filter-hidden', !matchesFilter(card));
      card.classList.add('blog-post--scroll-hidden');
    });

    matchingCards.slice(0, blogBatchSize).forEach((card) => {
      card.classList.remove('blog-post--scroll-hidden');
    });

    emptyState?.classList.toggle('hidden', matchingCards.length > 0);
    updateSentinel(matchingCards);
  }

  function revealBatch() {
    const matchingCards = allCards.filter(
      (card) => matchesFilter(card) && card.classList.contains('blog-post--scroll-hidden'),
    );

    if (matchingCards.length === 0) {
      scrollObserver?.disconnect();
      sentinel?.classList.add('hidden');
      return;
    }

    matchingCards.slice(0, blogBatchSize).forEach((card, i) => {
      card.classList.remove('blog-post--scroll-hidden');
      card.style.animationDelay = `${i * 80}ms`;
    });

    updateSentinel(allCards.filter(matchesFilter));
  }

  if (sentinel && allCards.length > blogBatchSize) {
    scrollObserver = new IntersectionObserver(
      (entries) => {
        if (entries.some((entry) => entry.isIntersecting)) {
          revealBatch();
        }
      },
      { rootMargin: '240px 0px' },
    );

    scrollObserver.observe(sentinel);
    updateSentinel(allCards.filter(matchesFilter));
  } else {
    sentinel?.remove();
  }

  filterButtons.forEach((button) => {
    button.addEventListener('click', () => {
      setActiveFilter(button);
      applyFilter(button.getAttribute('data-filter') ?? 'all');
    });
  });
</script>
