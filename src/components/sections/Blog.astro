---
import { Image } from 'astro:assets';
import { posts, blogBatchSize } from '../../data/blog';

const imageModules = import.meta.glob<{ default: ImageMetadata }>(
  '../../assets/blog/*.{png,jpg,jpeg,svg}',
  { eager: true },
);

const blogImages: Record<string, ImageMetadata> = {};
for (const [path, mod] of Object.entries(imageModules)) {
  const filename = path.split('/').pop()!;
  blogImages[filename] = mod.default;
}

const allPosts = posts;
const hasMorePosts = allPosts.length > blogBatchSize;
---

<section id="blog" class="mb-16 lg:mb-24">
  <div class="reveal mb-12 text-center">
    <h1 class="section-title mb-4" data-i18n="blog.title">Publications</h1>
    <p class="mx-auto max-w-2xl text-base leading-relaxed text-gray-400 md:text-lg" data-i18n="blog.lead">
      Technical articles on algorithms, data structures, cryptography, and software design from Making Code, my technical blog.
    </p>
  </div>

  <div id="blog-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
    {
      allPosts.map((post, index) => {
        const filename = post.coverImage.split('/').pop()!;
        const localImg = blogImages[filename];
        const isHidden = index >= blogBatchSize;

        return (
          <a
            href={post.mediumUrl}
            target="_blank"
            rel="noopener noreferrer"
            class:list={[
              'blog-post group glass-card overflow-hidden hover:border-accent-500/20 transition-all duration-500 reveal',
              isHidden && 'blog-post--hidden',
            ]}
            data-index={index}
            data-tags={JSON.stringify(post.tags)}
            style={`animation-delay: ${Math.min(index, blogBatchSize - 1) * 100}ms`}
            aria-label={`${post.title} — opens on Making Code`}
          >
            <div class="relative h-44 bg-gradient-to-br from-dark-600 to-dark-800 overflow-hidden">
              {
                localImg && (
                  <Image
                    src={localImg}
                    alt=""
                    width={400}
                    height={225}
                    class="h-full w-full object-cover opacity-80 transition-opacity group-hover:opacity-95"
                    loading={index < blogBatchSize ? 'eager' : 'lazy'}
                    decoding="async"
                  />
                )
              }
              <div class="absolute inset-0 bg-gradient-to-t from-dark-900 via-dark-900/30 to-transparent"></div>
              <div class="absolute top-3 right-3 w-8 h-8 rounded-lg bg-dark-900/60 backdrop-blur-sm flex items-center justify-center text-gray-400 group-hover:text-accent-400 transition-colors">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                </svg>
              </div>
            </div>
            <div class="p-5">
              <h3 class="text-base font-bold text-white mb-3 group-hover:text-accent-400 transition-colors line-clamp-2 uppercase tracking-wide">
                {post.title}
              </h3>
              <div class="flex flex-wrap gap-2 mb-3">
                {post.tags.map((tag) => (
                  <span class="tag text-xs">{tag}</span>
                ))}
              </div>
              <p class="text-gray-400 text-sm line-clamp-3 leading-relaxed">{post.description}</p>
            </div>
          </a>
        );
      })
    }
  </div>

  {
    hasMorePosts && (
      <div
        id="blog-sentinel"
        class="mt-8 flex justify-center py-4"
        aria-hidden="true"
      >
        <span class="text-sm text-gray-500" data-i18n="blog.loading">Loading more articles…</span>
      </div>
    )
  }
</section>

<style>
  .blog-post--hidden {
    display: none;
  }
</style>

<script define:vars={{ blogBatchSize, totalPosts: allPosts.length }}>
  const grid = document.getElementById('blog-grid');
  const sentinel = document.getElementById('blog-sentinel');
  if (!grid || !sentinel || totalPosts <= blogBatchSize) {
    sentinel?.remove();
  } else {
    const posts = [...grid.querySelectorAll('.blog-post--hidden')];
    let loading = false;

    const revealBatch = () => {
      if (loading || posts.length === 0) return;
      loading = true;

      const batch = posts.splice(0, blogBatchSize);
      batch.forEach((post, i) => {
        post.classList.remove('blog-post--hidden');
        post.style.animationDelay = `${i * 80}ms`;
      });

      loading = false;

      if (posts.length === 0) {
        observer.disconnect();
        sentinel.remove();
      }
    };

    const observer = new IntersectionObserver(
      (entries) => {
        if (entries.some((entry) => entry.isIntersecting)) {
          revealBatch();
        }
      },
      { rootMargin: '240px 0px' },
    );

    observer.observe(sentinel);
  }
</script>
