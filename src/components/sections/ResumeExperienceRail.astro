---
import type { Experience, Education } from '../../types';
import ResumeTimelineCard from './ResumeTimelineCard.astro';

type TimelineItem =
  | { kind: 'experience'; data: Experience }
  | { kind: 'education'; data: Education };

interface Props {
  timelineItems: TimelineItem[];
  firstEducationIndex: number;
}

const { timelineItems, firstEducationIndex } = Astro.props;
---

<div class="relative mb-12 reveal">
  <!-- Single continuous spine; dots sit on the line -->
  <div
    class="pointer-events-none absolute left-[10px] top-10 bottom-10 w-px bg-gradient-to-b from-accent-500/50 via-accent-500/25 to-transparent md:left-[12px]"
    aria-hidden="true"
  >
  </div>

  <div class="relative space-y-6 md:space-y-8">
    {
      timelineItems.map((item, index) => {
        const showEducationHeading = item.kind === 'education' && index === firstEducationIndex;

        return (
          <div class="relative">
            {showEducationHeading && (
              <h3 class="mb-6 text-xl font-semibold text-white md:mb-8" data-i18n="resume.educationHeading">Education</h3>
            )}

            <div class="flex gap-4 md:gap-6">
              <div class="relative z-[1] flex w-[22px] shrink-0 justify-center md:w-[26px]">
                <span
                  class="mt-6 h-3 w-3 shrink-0 rounded-full border-[3px] border-dark-900 bg-accent-500 shadow-[0_0_14px_rgba(52,211,153,0.25)] md:mt-7"
                  aria-hidden="true"
                />
              </div>

              <div class="min-w-0 flex-1 pb-1">
                <ResumeTimelineCard item={item} wide />
              </div>
            </div>
          </div>
        );
      })
    }
  </div>
</div>
