---
import { dictionary } from '../../i18n/dictionary';
import { skillCategories } from '../../data/resume';
import LocalePair from '../LocalePair.astro';
import type { LocalizedText } from '../../types';

const locKey = (key: string): LocalizedText => ({
  en: dictionary.en[key] ?? key,
  es: dictionary.es[key] ?? key,
});

const focusAreas = [
  { title: locKey('about.sum.archTitle'), value: locKey('about.focus.arch') },
  { title: locKey('about.sum.cloudTitle'), value: locKey('about.focus.cloud') },
  { title: locKey('about.sum.distTitle'), value: locKey('about.focus.dist') },
  { title: locKey('about.sum.perfTitle'), value: locKey('about.focus.perf') },
];

const summaryBody = locKey('about.summaryBody');
const summaryBody2 = locKey('about.summaryBody2');
const techLead = locKey('about.techLead');
---

<section id="about" class="mb-20">
  <div class="mb-16 reveal">
    <h2 class="section-title mb-6" data-i18n="about.summaryTitle">Professional Summary</h2>

    <div class="max-w-2xl space-y-4 text-pretty text-base leading-7 text-ink-body">
      <p>
        <LocalePair text={summaryBody} display="block" />
      </p>
      <p>
        <LocalePair text={summaryBody2} display="block" />
      </p>
    </div>

    <div class="mt-10 border-t border-white/[0.06] pt-8">
      <p class="section-label mb-5" data-i18n="about.focusTitle">Focus areas</p>
      <dl class="divide-y divide-white/[0.06] border-y border-white/[0.06]">
        {
          focusAreas.map(({ title, value }) => (
            <div class="stack-row py-4">
              <dt class="stack-row__label">
                <LocalePair text={title} />
              </dt>
              <dd class="stack-row__value text-pretty">
                <LocalePair text={value} display="block" />
              </dd>
            </div>
          ))
        }
      </dl>
    </div>
  </div>

  <div class="reveal">
    <h2 class="section-title mb-2" data-i18n="about.techTitle">Technologies</h2>
    <p class="mb-8 max-w-xl text-pretty text-base leading-7 text-ink-muted">
      <LocalePair text={techLead} display="block" />
    </p>

    <dl class="divide-y divide-white/[0.06] border-y border-white/[0.06]">
      {
        Object.entries(skillCategories).map(([skillKey, category]) => (
          <div class="stack-row py-4">
            <dt class="stack-row__label" data-i18n={`skills.label.${skillKey}`}>
              {category.label}
            </dt>
            <dd class="stack-row__value text-base leading-7">
              {category.skills.join(' · ')}
            </dd>
          </div>
        ))
      }
    </dl>
  </div>
</section>
