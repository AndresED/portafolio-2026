---
import { Image } from 'astro:assets';
import type { BlogPost } from '../types';
import { profile } from '../data/profile';
import RelatedTopics from './RelatedTopics.astro';
import { getTopicsForPost } from '../data/topics';

interface Props {
  post: BlogPost;
  imgSrc?: ImageMetadata;
}

const { post, imgSrc } = Astro.props;
const relatedTopics = getTopicsForPost(post.id);

function formatPostDate(iso: string): string {
  return new Date(iso).toLocaleDateString('en-GB', {
    day: 'numeric',
    month: 'long',
    year: 'numeric',
  });
}
---

<article class="reveal">
  {
    imgSrc && (
      <div class="mb-8 overflow-hidden rounded-xl border border-white/[0.06]">
        <Image
          src={imgSrc}
          alt={post.title}
          width={1200}
          height={675}
          class="aspect-video w-full object-cover"
          loading="eager"
          fetchpriority="high"
        />
      </div>
    )
  }

  <header class="mb-10 border-b border-white/[0.06] pb-10">
    <p class="section-label mb-3">
      <time datetime={post.publishedAt}>{formatPostDate(post.publishedAt)}</time>
      · {post.readingTime}
    </p>

    <h1 class="font-display text-balance text-3xl font-bold tracking-tight text-ink md:text-4xl">
      {post.title}
    </h1>

    <p class="mt-4 max-w-3xl text-pretty text-lg leading-8 text-ink-body">{post.description}</p>

    <div class="mt-5 flex flex-wrap gap-2">
      {post.tags.map((tag) => (
        <span class="tag">{tag}</span>
      ))}
    </div>

    <div class="mt-8 flex flex-wrap gap-3">
      <a href={post.mediumUrl} target="_blank" rel="noopener noreferrer" class="btn-primary">
        <span data-i18n="blog.readFull">Read full article</span>
        <span aria-hidden="true"> ↗</span>
      </a>
      <a href="/blog" class="btn-ghost" data-i18n="blog.detail.backToList">
        Back to publications
      </a>
    </div>

    <p class="mt-6 max-w-2xl text-sm leading-6 text-meta-500" data-i18n="blog.detail.canonicalNote">
      Full article hosted on Making Code — this page is a summary for discovery on andresed.dev.
    </p>
  </header>

  <RelatedTopics topics={relatedTopics} />

  <p class="mt-8 text-sm text-meta-500">
    <span data-i18n="blog.detail.author">Author:</span>{' '}
    <a
      href={profile.makingCodeUrl}
      rel="author"
      class="text-accent-400 transition-colors hover:text-accent-300"
    >
      {profile.name} · Making Code
    </a>
  </p>
</article>
