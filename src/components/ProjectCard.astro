---
import { Image } from 'astro:assets';
import type { Project } from '../../types';
import LocalePair from './LocalePair.astro';
import ProjectStackModal from './ProjectStackModal.astro';
import { projectPath } from '../data/seo';

interface Props {
  project: Project;
  imgSrc?: ImageMetadata;
  class?: string;
  style?: string;
  /** First above-the-fold card — eager load + fetchpriority for LCP. */
  priority?: boolean;
}

const { project, imgSrc, class: className, style, priority = false } = Astro.props;
const hasLayers = (project.layers?.length ?? 0) > 0;
---

<article
  class:list={['project-card group glass-card media-card transition-colors duration-200 hover:border-accent-500/25', className]}
  data-category={project.category}
  style={style}
>
  {
    imgSrc && (
      <div class="media-card__media">
        <Image
          src={imgSrc}
          alt={project.title}
          width={640}
          height={360}
          class="size-full object-cover opacity-90 transition-opacity duration-200 group-hover:opacity-100"
          loading={priority ? 'eager' : 'lazy'}
          decoding="async"
          fetchpriority={priority ? 'high' : undefined}
        />
      </div>
    )
  }

  <div class="media-card__body">
    <div class="mb-1 flex flex-wrap items-start justify-between gap-2">
      <h3 class="media-card__title">
        <a
          href={projectPath(project.id)}
          class="transition-colors hover:text-accent-400 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent-500/40"
        >
          {project.title}
        </a>
      </h3>
      {
        project.featured && (
          <span class="shrink-0 font-mono text-[10px] uppercase tracking-wide text-accent-400" data-i18n="portfolio.featuredBadge">
            Featured
          </span>
        )
      }
    </div>

    <p class="media-card__excerpt">{project.description}</p>

    {
      project.impact && (
        <p class="media-card__impact">
          <span class="mb-1 block font-mono text-xs text-meta-500" data-i18n="portfolio.meta.impact">Impact</span>
          <LocalePair text={project.impact} display="block" class="text-sm leading-6 text-ink-body" />
        </p>
      )
    }

    <div class="media-card__tags">
      {project.tags.map((tag) => (
        <span class="tag">{tag}</span>
      ))}
    </div>

    <div class="media-card__footer">
      <span>{project.techStack.slice(0, 3).join(' · ')}</span>
      <div class="flex flex-wrap items-center gap-x-4 gap-y-1">
        <a
          href={projectPath(project.id)}
          class="inline-flex items-center gap-1 text-meta-400 transition-colors duration-200 hover:text-accent-400 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent-500/40"
        >
          <span data-i18n="portfolio.link.caseStudy">Case study</span>
          <span aria-hidden="true">→</span>
        </a>
        {
          hasLayers && (
            <button
              type="button"
              class="inline-flex items-center gap-1 text-meta-400 transition-colors duration-200 hover:text-accent-400 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent-500/40"
              data-project-modal-open={project.id}
            >
              <span data-i18n="portfolio.link.stack">View stack</span>
              <span aria-hidden="true">→</span>
            </button>
          )
        }
        {
          project.githubUrl && (
            <a
              href={project.githubUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-1 text-meta-400 transition-colors duration-200 hover:text-accent-400 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent-500/40"
            >
              <span data-i18n="portfolio.link.github">GitHub</span>
              <span aria-hidden="true">↗</span>
            </a>
          )
        }
        {
          project.liveUrl && (
            <a
              href={project.liveUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-1 text-meta-400 transition-colors duration-200 hover:text-accent-400 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent-500/40"
            >
              <span data-i18n="portfolio.link.live">Live</span>
              <span aria-hidden="true">↗</span>
            </a>
          )
        }
      </div>
    </div>
  </div>
</article>

<ProjectStackModal project={project} />
