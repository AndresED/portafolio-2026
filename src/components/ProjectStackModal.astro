---
import type { Project } from '../types';
import LocalePair from './LocalePair.astro';

interface Props {
  project: Project;
}

const { project } = Astro.props;
const layers = project.layers ?? [];
---

{
  layers.length > 0 && (
    <dialog
      id={`project-modal-${project.id}`}
      class="project-modal"
      aria-labelledby={`project-modal-title-${project.id}`}
    >
      <div class="project-modal__panel">
        <header class="project-modal__header">
          <div>
            <p class="font-mono text-xs uppercase tracking-wide text-meta-500" data-i18n="portfolio.modal.eyebrow">
              Project breakdown
            </p>
            <h2 id={`project-modal-title-${project.id}`} class="project-modal__title">
              {project.title}
            </h2>
          </div>
          <button
            type="button"
            class="project-modal__close"
            data-project-modal-close
            aria-label="Close"
            data-i18n-aria="portfolio.modal.close"
          >
            <svg class="size-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
            </svg>
          </button>
        </header>

        <div class="project-modal__body">
          {
            project.role && (
              <p class="project-modal__intro">
                <span class="mb-1 block font-mono text-xs text-meta-500" data-i18n="portfolio.meta.role">Role</span>
                <LocalePair text={project.role} display="block" class="text-sm leading-6 text-ink-body" />
              </p>
            )
          }

          <ol class="project-modal__layers">
            {
              layers.map((layer, index) => (
                <li class="project-modal__layer">
                  <div class="project-modal__layer-index" aria-hidden="true">
                    {String(index + 1).padStart(2, '0')}
                  </div>
                  <div class="min-w-0 flex-1">
                    <h3 class="project-modal__layer-title">
                      <LocalePair text={layer.title} display="block" />
                    </h3>
                    <p class="project-modal__layer-summary">
                      <LocalePair text={layer.summary} display="block" />
                    </p>
                    {
                      layer.highlights && layer.highlights.length > 0 && (
                        <ul class="project-modal__highlights">
                          {layer.highlights.map((item) => (
                            <li>
                              <LocalePair text={item} display="block" />
                            </li>
                          ))}
                        </ul>
                      )
                    }
                    <div class="mt-3 flex flex-wrap gap-1.5">
                      {layer.techStack.map((tech) => (
                        <span class="tag">{tech}</span>
                      ))}
                    </div>
                  </div>
                </li>
              ))
            }
          </ol>
        </div>

        <footer class="project-modal__footer">
          {
            project.githubUrl && (
              <a
                href={project.githubUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="btn-secondary"
              >
                <span data-i18n="portfolio.link.github">GitHub</span>
                <span aria-hidden="true">↗</span>
              </a>
            )
          }
          {
            project.liveUrl && (
              <a
                href={project.liveUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="btn-primary"
              >
                <span data-i18n="portfolio.link.live">Live</span>
                <span aria-hidden="true">↗</span>
              </a>
            )
          }
          <button type="button" class="btn-secondary" data-project-modal-close data-i18n="portfolio.modal.close">
            Close
          </button>
        </footer>
      </div>
    </dialog>
  )
}
