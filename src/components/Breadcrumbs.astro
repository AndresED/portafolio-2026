---
interface Props {
  items: { name: string; href: string }[];
}

const { items } = Astro.props;
---

<nav aria-label="Breadcrumb" class="reveal mb-8">
  <ol class="flex flex-wrap items-center gap-x-2 gap-y-1 font-mono text-xs text-meta-500">
    {
      items.map((item, index) => (
        <li class="inline-flex items-center gap-2">
          {index > 0 && <span aria-hidden="true" class="text-white/20">/</span>}
          {
            index === items.length - 1 ? (
              <span class="text-ink-muted" aria-current="page">
                {item.name}
              </span>
            ) : (
              <a href={item.href} class="transition-colors hover:text-accent-400">
                {item.name}
              </a>
            )
          }
        </li>
      ))
    }
  </ol>
</nav>
