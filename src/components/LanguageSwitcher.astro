---

<div
  class="pointer-events-auto fixed right-4 top-[4.25rem] z-[100] lg:right-8 lg:top-6"
  role="region"
  aria-label="Language"
>
  <label for="lang-select" class="sr-only" data-i18n="lang.switch">Language</label>
  <select
    id="lang-select"
    class="cursor-pointer rounded-lg border border-white/10 bg-dark-800 px-3 py-2 text-base font-medium text-ink shadow-sm transition-colors duration-200 hover:border-accent-500/40 focus-visible:border-accent-500/50 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent-500/30"
    aria-describedby="lang-select-hint"
  >
    <option value="en" selected>EN</option>
    <option value="es">ES</option>
  </select>
  <span id="lang-select-hint" class="sr-only">Default language is English; your choice is saved in this browser.</span>
</div>
