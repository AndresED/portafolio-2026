---
import MainLayout from '../layouts/MainLayout.astro';
import About from '../components/sections/About.astro';
import Resume from '../components/sections/Resume.astro';
import Portfolio from '../components/sections/Portfolio.astro';
import Blog from '../components/sections/Blog.astro';
import Contact from '../components/sections/Contact.astro';
import { profile } from '../data/profile';
---

<MainLayout currentPage="home">
  <About />
  <Resume />
  <Portfolio />
  <Blog />
  <Contact />

  <!-- Footer -->
  <footer class="mt-16 pt-8 border-t border-white/[0.06]">
    <div class="flex flex-col md:flex-row items-center justify-between gap-4 text-sm text-gray-500">
      <p>
        &copy; {new Date().getFullYear()} {profile.name}.{' '}
        <span data-i18n="footer.rights">All rights reserved.</span>
      </p>
      <span class="flex items-center gap-2">
        <span data-i18n="layout.builtWithFooter">Built with</span>
        <svg class="h-4 w-4 text-red-500" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z" />
        </svg>
      </span>
    </div>
  </footer>
</MainLayout>