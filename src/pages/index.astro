---
import MainLayout from '../layouts/MainLayout.astro';
import Hero from '../components/sections/Hero.astro';
import AtAGlance from '../components/sections/AtAGlance.astro';
import About from '../components/sections/About.astro';
import TopicHubs from '../components/sections/TopicHubs.astro';
import FeaturedProjects from '../components/sections/FeaturedProjects.astro';
import Resume from '../components/sections/Resume.astro';
import Certifications from '../components/sections/Certifications.astro';
import ContactCta from '../components/sections/ContactCta.astro';
import Footer from '../components/Footer.astro';
import { profile } from '../data/profile';
import { siteDescription } from '../data/site';
---

<MainLayout
  currentPage="home"
  title={`${profile.name} | Senior Backend Engineer — NestJS, AWS & Microservices`}
  description={siteDescription}
>
  <Hero />
  <AtAGlance />
  <About />
  <TopicHubs />
  <FeaturedProjects />
  <Resume />
  <Certifications />
  <ContactCta />
  <Footer />
</MainLayout>
