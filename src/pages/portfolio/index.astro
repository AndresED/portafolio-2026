---
import MainLayout from '../../layouts/MainLayout.astro';
import Portfolio from '../../components/sections/Portfolio.astro';
import ContactCta from '../../components/sections/ContactCta.astro';
import Footer from '../../components/Footer.astro';
import { profile } from '../../data/profile';
import { projects } from '../../data/projects';
import { buildItemListNode, buildWebPageNode, projectPageUrl } from '../../data/seo';
import { absoluteUrl } from '../../data/site';

const pageUrl = absoluteUrl('/portfolio');
const pageDescription =
  'Production IoT platforms, NestJS microservices, event-driven architectures, and open-source reference builds — case studies with stack breakdowns.';
const jsonLdExtra = [
  buildWebPageNode({
    name: `${profile.name} | Portfolio`,
    description: pageDescription,
    url: pageUrl,
    type: 'CollectionPage',
  }),
  buildItemListNode(
    pageUrl,
    projects.map((project) => ({
      name: project.title,
      url: projectPageUrl(project.id),
    })),
  ),
];
---

<MainLayout
  currentPage="portfolio"
  title={`${profile.name} | Portfolio — NestJS, AWS & IoT Projects`}
  description={pageDescription}
  jsonLdExtra={jsonLdExtra}
>
  <Portfolio />
  <ContactCta />
  <Footer />
</MainLayout>
