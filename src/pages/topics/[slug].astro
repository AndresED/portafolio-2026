---
import MainLayout from '../../layouts/MainLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import TopicHubDetail from '../../components/TopicHubDetail.astro';
import ContactCta from '../../components/sections/ContactCta.astro';
import Footer from '../../components/Footer.astro';
import { getTopicById, topics } from '../../data/topics';
import {
  buildBreadcrumbNode,
  buildWebPageNode,
  topicPageUrl,
  topicSeoDescription,
  topicSeoTitle,
} from '../../data/seo';
import { absoluteUrl, homepageUrl } from '../../data/site';

export function getStaticPaths() {
  return topics.map((topic) => ({
    params: { slug: topic.id },
  }));
}

const { slug } = Astro.params;
const topic = getTopicById(slug!);

const pageUrl = topicPageUrl(topic.id);
const seoTitle = topicSeoTitle(topic);
const seoDescription = topicSeoDescription(topic);

const jsonLdExtra = [
  buildWebPageNode({
    name: seoTitle,
    description: seoDescription,
    url: pageUrl,
    type: 'CollectionPage',
  }),
  buildBreadcrumbNode([
    { name: 'Home', url: homepageUrl() },
    { name: 'Topics', url: absoluteUrl('/topics') },
    { name: topic.title.en, url: pageUrl },
  ]),
];
---

<MainLayout
  currentPage="topics"
  title={seoTitle}
  description={seoDescription}
  jsonLdExtra={jsonLdExtra}
>
  <div class="mx-auto max-w-4xl px-4 py-10 lg:px-8">
    <Breadcrumbs
      items={[
        { name: 'Home', href: '/' },
        { name: 'Topics', href: '/topics' },
        { name: topic.title.en, href: pageUrl },
      ]}
    />
    <TopicHubDetail topic={topic} />
  </div>
  <ContactCta />
  <Footer />
</MainLayout>
