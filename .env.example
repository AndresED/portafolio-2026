# Set to true at build/deploy time to show in-progress AWS certification on the site.
# After passing the exam, set status to `valid` in src/data/resume.ts and leave this false.
PUBLIC_SHOW_IN_PROGRESS_CERTIFICATIONS=false

# EmailJS — contact form (https://www.emailjs.com/)
# In the EmailJS template Settings, set To Email to: {{to_email}}
PUBLIC_EMAILJS_SERVICE_ID=
PUBLIC_EMAILJS_TEMPLATE_ID=
PUBLIC_EMAILJS_PUBLIC_KEY=

# Optional analytics (leave empty to disable)
# Plausible: your registered domain, e.g. andresed.dev
PUBLIC_PLAUSIBLE_DOMAIN=
# Google Analytics 4 measurement ID, e.g. G-XXXXXXXXXX
PUBLIC_GA_MEASUREMENT_ID=
